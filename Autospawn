				-- Kiểm tra nút lính có tồn tại và đang sẵn sàng kích hoạt
				if slotButton and slotButton:IsA("ImageButton") and slotButton.Active == true then[span_2](start_span)[span_2](end_span)
					BindSpawnUnit(slotButton)[span_3](start_span)[span_3](end_span)
					task.wait(0.05) -- Giảm tải request gửi lên server cùng lúc
				end
			end
		end
	end
end)
