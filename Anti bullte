-- HÀM XỬ LÝ ANTI NO COLLISION & HỘP BẢO VỆ ĐEN
-------------------------------------------------------------------------------
local function lockNoCollisionObject(part)
    if not AntiNoCollisionEnabled then return end
    if part:IsA("BasePart") and (part.Name == "Projectile" or part:FindFirstAncestor("Projectile")) then
        task.wait(0.01)
        if not part or not part.Parent then return end

        local pName = part.Name
        if part.Parent and part.Parent:IsA("Model") then pName = part.Parent.Name end
        
        if not table.find(DiscoveredProjectiles, pName) then
            table.insert(DiscoveredProjectiles, pName)
        end

        local state = ProjectileStates[pName] or 1
        if state ~= 1 and state ~= 3 then return end

        part.CanCollide = true
        local highLocation = part.CFrame + Vector3.new(0, 500, 0)
        part.CFrame = highLocation

        local box = Instance.new("Part")
        box.Name = "FixedCageBox"
        box.Size = part.Size + Vector3.new(1.5, 1.5, 1.5)
        box.CFrame = highLocation
        box.Anchored = true
        box.CanCollide = true
        box.Material = Enum.Material.Glass
        box.Transparency = 0.4
        box.Color = Color3.fromRGB(255, 170, 0)
        box.Parent = Workspace

        local sBox = Instance.new("SelectionBox")
        sBox.Adornee = box
        sBox.Color3 = Color3.fromRGB(255, 255, 255)
        sBox.Parent = box

        local connection
        connection = RunService.Stepped:Connect(function()
            if part and part.Parent and box and box.Parent then
                for _, shieldData in pairs(ActiveBlackShields) do
                    if shieldData.Box and shieldData.Box.Parent then
                        local dist = (part.Position - shieldData.Box.Position).Magnitude
                        if dist <= 12 then
                            highLocation = highLocation + Vector3.new(100, 0, 100)
                            box.CFrame = highLocation
                        end
                    end
                end
                part.CFrame = highLocation
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            else
                if connection then connection:Disconnect() end
                if box then box:Destroy() end
            end
        end)

        part.Destroying:Connect(function()
            if connection then connection:Disconnect() end
            if box then box:Destroy() end
        end)
    end
end

local function toggleAntiNoCollision(state)
    AntiNoCollisionEnabled = state
    if state then
        for _, descendant in ipairs(Workspace:GetDescendants()) do
            task.spawn(lockNoCollisionObject, descendant)
        end
        AntiNoCollisionConnection = Workspace.DescendantAdded:Connect(function(descendant)
            lockNoCollisionObject(descendant)
        end)
    else
        if AntiNoCollisionConnection then
            AntiNoCollisionConnection:Disconnect()
            AntiNoCollisionConnection = nil
        end
    end
end

-- Quản lý hộp bảo vệ đen (State 3)
RunService.Heartbeat:Connect(function()
    for eName, state in pairs(EnemyStates) do
        if state == 3 then
            local charPos = nil
            local player = Players:FindFirstChild(eName)
            if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                charPos = player.Character.HumanoidRootPart.Position
            end
            
            if not charPos then
                local enemyFolder = Workspace:FindFirstChild("EnemyFolder")
                local npc = enemyFolder and enemyFolder:FindFirstChild(eName) or Workspace.NPCFolders:FindFirstChild(eName, true)
                if npc then charPos, _ = getObjectData(npc) end
            end

            if charPos then
                if not ActiveBlackShields[eName] then
                    local sBox = Instance.new("Part")
                    sBox.Name = "Delta_Black_Protection_Box"
                    sBox.Size = Vector3.new(10, 12, 10)
                    sBox.Color = Color3.fromRGB(10, 10, 10)
                    sBox.Material = Enum.Material.ForceField
                    sBox.Transparency = 0.3
                    sBox.Anchored = true
                    sBox.CanCollide = true
                    sBox.Parent = Workspace

                    local sel = Instance.new("SelectionBox")
                    sel.Adornee = sBox
                    sel.Color3 = Color3.fromRGB(0, 0, 0)
                    sel.Parent = sBox

                    ActiveBlackShields[eName] = {Box = sBox, Selection = sel}
                end
                ActiveBlackShields[eName].Box.CFrame = CFrame.new(charPos)
            end
        else
            if ActiveBlackShields[eName] then
                if ActiveBlackShields[eName].Box then ActiveBlackShields[eName].Box:Destroy() end
                ActiveBlackShields[eName] = nil
            end
        end
    end
end)

