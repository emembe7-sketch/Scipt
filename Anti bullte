-- ENGINE HOOK: ANTI-SELF-DESTRUCT (CHẶN ĐẠN ĐÁNH TEAM MÌNH, ÉP ĐÁNH TEAM ĐỊCH)
-------------------------------------------------------------------------------
task.spawn(function()
    for _, v in pairs(getgc(true)) do
        if type(v) == "function" and debug.info(v, "n") == "TagTeamCheck" then
            hookfunction(v, function(character1, character2)
                if AntiSelfDestructEnabled then
                    -- Kiểm tra xem mục tiêu bị trúng đạn (character2) có phải lính/team mình không
                    local isChar2Friendly = CollectionService:HasTag(character2, "Friendly")
                    local isChar2Enemy = CollectionService:HasTag(character2, "Enemy")
                    
                    -- NẾU MỤC TIÊU BỊ TRÚNG LÀ TEAM MÌNH: 
                    -- Ép game hiểu đây là đồng đội -> KHÔNG GÂY DAMAGE
                    if isChar2Friendly then
                        return true 
                    end
                    
                    -- NẾU MỤC TIÊU BỊ TRÚNG LÀ TEAM ĐỊCH:
                    -- Ép game hiểu đây là kẻ thù -> LUÔN LUÔN GÂY DAMAGE
                    if isChar2Enemy then
                        return false
                    end
                end
                
                -- Trường hợp không bật Anti-self-destruct hoặc mục tiêu khác: Giữ nguyên logic gốc
                return CollectionService:HasTag(character1, "Friendly") == CollectionService:HasTag(character2, "Friendly")
            end)
            print("Welcome")
            break
        end
    end
end)

-------------------------------------------------------------------------------
-- HÀM TRÍCH XUẤT TỌA ĐỘ VÀ KÍCH THƯỚC VẬT THỂ
-------------------------------------------------------------------------------
local function getObjectData(obj)
    if not obj then return nil, nil end
    if obj:IsA("BasePart") then
        return obj.Position, obj.Size
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart.Position, obj.PrimaryPart.Size
        else
            local childPart = obj:FindFirstChildOfClass("BasePart")
            if childPart then return childPart.Position, childPart.Size end
        end
    end
    return nil, nil
end

-------------------------------------------------------------------------------
-- THUẬT TOÁN QUÉT BASE TOÀN DIỆN THEO SƠ ĐỒ WORKSPACE
-------------------------------------------------------------------------------
local function scanBases()
    pcall(function()
        local myTeamStr = ""
        if LocalPlayer.Team then
            myTeamStr = LocalPlayer.Team.Name:lower()
        elseif LocalPlayer.Parent and LocalPlayer:FindFirstChild("TeamColor") then
            myTeamStr = tostring(LocalPlayer.TeamColor):lower()
        end

        -- Quét theo sơ đồ: Workspace -> NPCFolders -> BaseFolder
        local npcFolders = Workspace:FindFirstChild("NPCFolders")
        if npcFolders then
            local baseFolder = npcFolders:FindFirstChild("BaseFolder")
            if baseFolder then
                local redBase = baseFolder:FindFirstChild("Red Base") or baseFolder:FindFirstChild("RedBase")
                local blueBase = baseFolder:FindFirstChild("Blue Base") or baseFolder:FindFirstChild("BlueBase")
                
                local redPos, redSize = getObjectData(redBase)
                local bluePos, blueSize = getObjectData(blueBase)

                if string.find(myTeamStr, "blue") or string.find(myTeamStr, "xanh") then
                    EnemyTargetPosition = redPos
                    EnemyBaseSize = redSize or Vector3.new(10,10,10)
                    MyBasePosition = bluePos
                elseif string.find(myTeamStr, "red") or string.find(myTeamStr, "đỏ") then
                    EnemyTargetPosition = bluePos
                    EnemyBaseSize = blueSize or Vector3.new(10,10,10)
                    MyBasePosition = redPos
                else
                    EnemyTargetPosition = redPos or bluePos
                    MyBasePosition = bluePos or redPos
                end
                return
            end
        end
        
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            MyBasePosition = LocalPlayer.Character.HumanoidRootPart.Position
        end
    end)
end

-------------------------------------------------------------------------------
-- QUÉT DANH SÁCH KẺ ĐỊCH CHUẨN (MAPPED THEO ENEMYFOLDER & NPCFOLDERS)
-------------------------------------------------------------------------------
local function scanEnemies()
    pcall(function()
        -- 1. Quét người chơi khác (nếu có đối địch)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not table.find(DiscoveredEnemies, player.Name) then
                    table.insert(DiscoveredEnemies, player.Name)
                end
            end
        end
        
        -- 2. Tìm sâu trong EnemyFolder (Địch có chỉ số trong sơ đồ)
        local enemyFolder = Workspace:FindFirstChild("EnemyFolder")
        if enemyFolder then
            for _, enemy in ipairs(enemyFolder:GetChildren()) do
                if enemy:IsA("Model") or enemy:IsA("BasePart") then
                    if not table.find(DiscoveredEnemies, enemy.Name) then
                        table.insert(DiscoveredEnemies, enemy.Name)
                    end
                end
            end
        end

        -- 3. Tìm quét thêm trong NPCFolders đề phòng các map custom chứa boss/địch lẻ
        local npcFolders = Workspace:FindFirstChild("NPCFolders")
        if npcFolders then
            for _, child in ipairs(npcFolders:GetChildren()) do
                -- Bỏ qua BaseFolder và FriendlyFolder (Team mình)
                if child.Name ~= "BaseFolder" and child.Name ~= "FriendlyFolder" then
                    if child:IsA("Model") or child:IsA("BasePart") then
                        if not table.find(DiscoveredEnemies, child.Name) then
                            table.insert(DiscoveredEnemies, child.Name)
                        end
                    end
                    -- Quét thêm một cấp con nếu địch nằm trong folder con của NPCFolders
                    if child:IsA("Folder") or child:IsA("Configuration") then
                        for _, subChild in ipairs(child:GetChildren()) do
                            if not table.find(DiscoveredEnemies, subChild.Name) then
                                table.insert(DiscoveredEnemies, subChild.Name)
                            end
                        end
                    end
                end
            end
        end
    end)
end

-- Hàm lấy tọa độ mục tiêu đang bị chọn Màu Đỏ
local function getRedTargetPlayerPosition()
    for eName, state in pairs(EnemyStates) do
        if state == 2 then -- Đang Target Đỏ
            -- Check trong Players
            local player = Players:FindFirstChild(eName)
            if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                return player.Character.HumanoidRootPart.Position
            end
            -- Check trong EnemyFolder
            local enemyFolder = Workspace:FindFirstChild("EnemyFolder")
            if enemyFolder then
                local npc = enemyFolder:FindFirstChild(eName)
                if npc then
                    local pos, _ = getObjectData(npc)
                    if pos then return pos end
                end
            end
            -- Check toàn bộ NPCFolders ngoại trừ đồng đội
            local npcFolders = Workspace:FindFirstChild("NPCFolders")
            if npcFolders then
                local npc = npcFolders:FindFirstChild(eName, true)
                if npc and not npc:FindFirstAncestor("FriendlyFolder") then
                    local pos, _ = getObjectData(npc)
                    if pos then return pos end
                end
            end
        end
    end
    return nil
end

-------------------------------------------------------------------------------
-- HÀM BẬT/TẮT SÀN CẢN Anti Sky
-------------------------------------------------------------------------------
local function updateAntiSky()
    if AntiSkyEnabled then
        scanBases()
        if EnemyTargetPosition and MyBasePosition then
            if AntiSkyPart then AntiSkyPart:Destroy() end

            local enemyRoof = EnemyTargetPosition + Vector3.new(0, (EnemyBaseSize.Y / 2) + 15, 0)
            local myRoof = MyBasePosition + Vector3.new(0, 15, 0)
            
            local dirToEnemy = (enemyRoof - myRoof).Unit
            local extendedEnemyRoof = enemyRoof + (dirToEnemy * 30)
            local extendedMyRoof = myRoof - (dirToEnemy * 30)

            local totalDistance = (extendedEnemyRoof - extendedMyRoof).Magnitude

            AntiSkyPart = Instance.new("Part")
            AntiSkyPart.Name = "Delta_AntiSky_Roof"
            AntiSkyPart.Size = Vector3.new(25, 1.5, totalDistance)
            AntiSkyPart.CFrame = CFrame.lookAt(extendedEnemyRoof, extendedMyRoof) * CFrame.new(0, 0, -totalDistance / 2)
            AntiSkyPart.Color = Color3.fromRGB(0, 170, 255)
            AntiSkyPart.Material = Enum.Material.ForceField
            AntiSkyPart.Transparency = 0.5
            AntiSkyPart.Anchored = true
            AntiSkyPart.CanCollide = true
            AntiSkyPart.Parent = Workspace
        end
    else
        if AntiSkyPart then
            AntiSkyPart:Destroy()
            AntiSkyPart = nil
        end
    end
end

-- Vòng lặp quét dữ liệu nền
task.spawn(function()
    while true do
        scanBases()
        scanEnemies()
        if AntiSkyEnabled then updateAntiSky() end
        task.wait(2)
    end
end)

