local function refreshList(filterText)
    for _, child in ipairs(ListFrame:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    filterText = filterText:lower()

    for _, pName in ipairs(DiscoveredProjectiles) do
        if filterText == "" or string.find(pName:lower(), filterText) then
            local ItemButton = Instance.new("TextButton")
            ItemButton.Size = UDim2.new(1, -6, 0, 32)
            ItemButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            ItemButton.Text = "  " .. pName
            ItemButton.Font = Enum.Font.SourceSansBold
            ItemButton.TextSize = 14
            ItemButton.TextXAlignment = Enum.TextXAlignment.Left
            ItemButton.BorderSizePixel = 0
            ItemButton.Active = true
            ItemButton.ZIndex = 4
            blockCameraRotation(ItemButton)
            
            local UICornerItem = Instance.new("UICorner")
            UICornerItem.CornerRadius = UDim.new(0, 6)
            UICornerItem.Parent = ItemButton
            
            local currentState = ProjectileStates[pName] or 1
            if currentState == 1 then ItemButton.TextColor3 = Color3.fromRGB(160, 160, 160)
            elseif currentState == 2 then ItemButton.TextColor3 = Color3.fromRGB(0, 255, 100)
            elseif currentState == 3 then ItemButton.TextColor3 = Color3.fromRGB(255, 50, 50)
            elseif currentState == 4 then ItemButton.TextColor3 = Color3.fromRGB(255, 215, 0)
            end
            
            ItemButton.MouseButton1Click:Connect(function()
                local nextState = (ProjectileStates[pName] or 1) + 1
                if nextState > 4 then nextState = 1 end
                ProjectileStates[pName] = nextState
                refreshList(SearchBox.Text)
            end)
            ItemButton.Parent = ListFrame
        end
    end
    ListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

local function refreshTargetList(filterText)
    for _, child in ipairs(TargetListFrame:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    filterText = filterText:lower()

    for _, eName in ipairs(DiscoveredEnemies) do
        if filterText == "" or string.find(eName:lower(), filterText) then
