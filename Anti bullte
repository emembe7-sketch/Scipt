            ItemButton.TextXAlignment = Enum.TextXAlignment.Left
            ItemButton.BorderSizePixel = 0
            ItemButton.Active = true
            ItemButton.ZIndex = 2
            blockCameraRotation(ItemButton)

            local UICornerItem = Instance.new("UICorner")
            UICornerItem.CornerRadius = UDim.new(0, 6)
            UICornerItem.Parent = ItemButton

            local currentState = EnemyStates[eName] or 1
            if currentState == 1 then ItemButton.TextColor3 = Color3.fromRGB(160, 160, 160)
            elseif currentState == 2 then ItemButton.TextColor3 = Color3.fromRGB(255, 50, 50)
            elseif currentState == 3 then ItemButton.TextColor3 = Color3.fromRGB(50, 50, 50)
            end

            ItemButton.MouseButton1Click:Connect(function()
                local nextState = (EnemyStates[eName] or 1) + 1
                if nextState > 3 then nextState = 1 end
                
