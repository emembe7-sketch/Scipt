-- =============================================================================
-- AUTO SPAWN ALL 8 SLOTS (ULTRA LIGHTWEIGHT - ALWAYS ON TOP)
-- =============================================================================
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- 1. TẠO CẤU TRÚC GUI (ĐÃ TỐI ƯU ĐỂ KHÔNG BỊ ĐÈ)
local ScreenGUI = PlayerGui:FindFirstChild("AutoSpawnHolder") or Instance.new("ScreenGui")
ScreenGUI.Name = "AutoSpawnHolder"
ScreenGUI.ResetOnSpawn = false
ScreenGUI.DisplayOrder = 999999999 -- display order cực lớn để luôn nằm TRÊN CÙNG tất cả UI game
ScreenGUI.IgnoreGuiInset = true    -- Đè qua cả thanh topbar mặc định của Roblox
ScreenGUI.Parent = PlayerGui

local AutoButton = ScreenGUI:FindFirstChild("AutoSpawnButton") or Instance.new("TextButton")
AutoButton.Name = "AutoSpawnButton"
AutoButton.Size = UDim2.new(0, 100, 0, 40)
AutoButton.Position = UDim2.new(0.85, 0, 0.15, 0)
AutoButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
AutoButton.Text = "AUTO: OFF"
AutoButton.TextColor3 = Color3.fromRGB(255, 100, 100)
AutoButton.Font = Enum.Font.SourceSansBold
AutoButton.TextSize = 16
AutoButton.ZIndex = 999999999 -- ZIndex cực cao để đè mọi nút khác
AutoButton.Parent = ScreenGUI

local UICorner = AutoButton:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = AutoButton

local UIStroke = AutoButton:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(255, 100, 100)
UIStroke.Thickness = 2
UIStroke.Parent = AutoButton

-- 2. LOGIC KÉO THẢ DI CHUYỂN NÚT
local dragging, dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	local TargetPosition = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	TweenService:Create(AutoButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = TargetPosition}):Play()
end

AutoButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = AutoButton.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

AutoButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

-- 3. LOGIC BẬT/TẮT TRẠNG THÁI AUTO
local AutoSpawnEnabled = false

AutoButton.Activated:Connect(function()
	AutoSpawnEnabled = not AutoSpawnEnabled
	
	if AutoSpawnEnabled then
		AutoButton.Text = "AUTO: ON"
		AutoButton.TextColor3 = Color3.fromRGB(100, 255, 100)
		UIStroke.Color = Color3.fromRGB(100, 255, 100)
		AutoButton.BackgroundColor3 = Color3.fromRGB(25, 50, 25)
	else
		AutoButton.Text = "AUTO: OFF"
		AutoButton.TextColor3 = Color3.fromRGB(255, 100, 100)
		UIStroke.Color = Color3.fromRGB(255, 100, 100)
		AutoButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	end
end)

-- 4. QUẢN LÝ COOLDOWN TỪNG SLOT RIÊNG BIỆT (HẾT HỒI CHIÊU LÀ BẮN EVENT NGAY)
local Slots = {"Slot1", "Slot2", "Slot3", "Slot4", "Slot5", "Slot6", "Slot7", "Slot8"}

for _, slotName in ipairs(Slots) do
	task.spawn(function()
		while true do
			local Events = ReplicatedStorage:FindFirstChild("Events")
			local RemoteFunction = Events and Events:FindFirstChild("RemoteFunction")
			local PlayerSpawn = RemoteFunction and RemoteFunction:FindFirstChild("PlayerSpawn")
			
			if not AutoSpawnEnabled or not PlayerSpawn then
				task.wait(0.5)
			else
				local success, cooldown = pcall(function()
					return PlayerSpawn:InvokeServer(slotName)
				end)
				
				if success and type(cooldown) == "number" and cooldown > 0 then
					task.wait(cooldown)
				else
					-- Nếu thất bại (chưa đủ tiền mua lính), đợi 0.2s rồi kiểm tra lại ngay
					task.wait(0.2)
				end
			end
		end
	end)
end
