local function createHollowCage(cframe, size)
    local cageModel = Instance.new("Model")
    cageModel.Name = "Delta_Hollow_Cage"
    cageModel.Parent = Workspace
    local thickness = 0.5
    local walls = {
        {Size = Vector3.new(size.X, thickness, size.Z), Offset = CFrame.new(0, size.Y/2, 0)},
        {Size = Vector3.new(size.X, thickness, size.Z), Offset = CFrame.new(0, -size.Y/2, 0)},
        {Size = Vector3.new(thickness, size.Y, size.Z), Offset = CFrame.new(size.X/2, 0, 0)},
        {Size = Vector3.new(thickness, size.Y, size.Z), Offset = CFrame.new(-size.X/2, 0, 0)},
        {Size = Vector3.new(size.X, size.Y, thickness), Offset = CFrame.new(0, 0, size.Z/2)},
        {Size = Vector3.new(size.X, size.Y, thickness), Offset = CFrame.new(0, 0, -size.Z/2)},
    }
    for _, w in ipairs(walls) do
        local p = Instance.new("Part")
        p.Size = w.Size; p.CFrame = cframe * w.Offset; p.Transparency = 0.85
        p.Color = Color3.fromRGB(255, 50, 50); p.Material = Enum.Material.SmoothPlastic
        p.Anchored = true; p.CanCollide = true; p.Parent = cageModel
    end
    return cageModel
end

local function createStraightTunnel(startPos, endPos, bulletSize)
    local tunnelModel = Instance.new("Model")
    tunnelModel.Name = "Delta_Straight_Tunnel"
    tunnelModel.Parent = Workspace

    local distance = (endPos - startPos).Magnitude
    local directionCFrame = CFrame.lookAt(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
    local tunnelWidth = bulletSize.X + 4
    local tunnelHeight = bulletSize.Y + 4
    local wallThickness = 0.4

    local components = {
        {Size = Vector3.new(tunnelWidth, wallThickness, distance), Offset = CFrame.new(0, tunnelHeight / 2, 0)},   
        {Size = Vector3.new(tunnelWidth, wallThickness, distance), Offset = CFrame.new(0, -tunnelHeight / 2, 0)},  
        {Size = Vector3.new(wallThickness, tunnelHeight, distance), Offset = CFrame.new(tunnelWidth / 2, 0, 0)},   
        {Size = Vector3.new(wallThickness, tunnelHeight, distance), Offset = CFrame.new(-tunnelWidth / 2, 0, 0)}   
    }
    for _, comp in ipairs(components) do
        local wall = Instance.new("Part")
        wall.Size = comp.Size; wall.CFrame = directionCFrame * comp.Offset; wall.Transparency = 0.9 
        wall.Color = Color3.fromRGB(255, 215, 0); wall.Material = Enum.Material.SmoothPlastic
        wall.Anchored = true; wall.CanCollide = true; wall.Parent = tunnelModel
    end
    return tunnelModel
end

local function createCenterBaseWall(basePos, baseSize)
    local wallModel = Instance.new("Model")
    wallModel.Name = "Delta_Base_Block_Walls"
    wallModel.Parent = Workspace

    local centerWall = Instance.new("Part")
    centerWall.Name = "Mid_Base_Wall"
    centerWall.Size = Vector3.new(baseSize.X + 2, baseSize.Y + 4, 1.5)
    centerWall.CFrame = CFrame.new(basePos)
    centerWall.Transparency = 0.8; centerWall.Color = Color3.fromRGB(255, 215, 0)
    centerWall.Material = Enum.Material.ForceField; centerWall.Anchored = true; centerWall.CanCollide = true
    centerWall.Parent = wallModel
    return wallModel
end

