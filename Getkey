-- =======================================================
-- HÀM LẤY DỮ LIỆU TỪ GITHUB (ĐÃ BYPASS CACHE)
-- =======================================================
local function getGitHubData(targetUrl)
    local antiCacheUrl = targetUrl .. "?nocache=" .. tostring(os.clock()):gsub("%.", "")
    local success, result
    if request then
        success, result = pcall(function()
            local response = request({Url = antiCacheUrl, Method = "GET"})
            return response.Body
        end)
    end
    if not success or not result then
        success, result = pcall(function()
            return game:HttpGet(antiCacheUrl)
        end)
    end
    return success, result
end

-- Hàm vô hiệu hóa Key động (Chỉ chạy khi dùng key 24h)
local function invalidateKeyOnGitHub()
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local getResponse = req({ Url = GitHubApiUrl, Method = "GET", Headers = { ["Authorization"] = "token " .. GITHUB_TOKEN } })
        local getData = HttpService:JSONDecode(getResponse.Body)
        local sha = getData.sha

        req({
            Url = GitHubApiUrl,
            Method = "PUT",
            Headers = {
                ["Authorization"] = "token " .. GITHUB_TOKEN,
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode({
                message = "Vo hieu hoa Key sau khi dung",
                content = "S0VZX0RBX1NVX0RVTkc=", -- Chữ "KEY_DA_SU_DUNG" mã hóa sang Base64
                sha = sha
            })
        })
    end
end

