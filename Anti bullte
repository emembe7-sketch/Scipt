local ProjectileFolder = Workspace:WaitForChild("Projectile", 5)
if ProjectileFolder then
    local function processProjectile(projectile)
        task.wait()
        if not projectile or not projectile.Parent then return end

        local pName = projectile.Name
        if string.find(pName:lower(), "arrow") then return end

        if not table.find(DiscoveredProjectiles, pName) then
            table.insert(DiscoveredProjectiles, pName)
            refreshList(SearchBox.Text)
        end

        local state = ProjectileStates[pName] or 1
        local targetPart = projectile:IsA("BasePart") and projectile or (projectile:IsA("Model") and (projectile.PrimaryPart or projectile:FindFirstChildOfClass("BasePart")))
        if not targetPart then return end

        if AntiExplodeEnabled and (state == 3 or state == 1) then
            targetPart.Anchored = false; targetPart.CanCollide = true
            targetPart.AssemblyLinearVelocity = Vector3.new(0, 350, 0)
            
            task.delay(0.12, function()
                if targetPart and targetPart.Parent then
                    if state == 3 then
                        local compactSize = targetPart.Size + Vector3.new(2, 2, 2)
                        local cage = createHollowCage(targetPart.CFrame, compactSize)
                        projectile.AncestryChanged:Connect(function() if not projectile:IsDescendantOf(game) then cage:Destroy() end end)
                    elseif state == 1 then
                        targetPart.AssemblyLinearVelocity = Vector3.zero
                        targetPart.AssemblyAngularVelocity = Vector3.zero
                        targetPart.Anchored = true
                    end
                end
            end)
            return
        end

        -- LOGIC TRẠNG THÁI XANH LÁ (STATE 2): MỞ KHÓA MẶC ĐỊNH
        if state == 2 then
            local redEnemyPos = getRedTargetPlayerPosition()
            
            -- 1. Ưu tiên cao nhất: Nếu có chọn Target Đỏ thì Teleport đạn thẳng tới vị trí Địch
            if redEnemyPos then
                for _, child in ipairs(targetPart:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") or child:IsA("BodyForce") then child:Destroy() end
                end
                targetPart.Anchored = false
                targetPart.CanCollide = true
                targetPart.CFrame = CFrame.new(redEnemyPos)
                return
            end

            -- 2. Nếu Bật HitBase (và KHÔNG chọn Target Đỏ) thì TP đạn tới Base
            if HitBaseEnabled then
                if not EnemyTargetPosition then scanBases() end
                if EnemyTargetPosition then
                    for _, child in ipairs(targetPart:GetChildren()) do
                        if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") or child:IsA("BodyForce") then child:Destroy() end
                    end
                    targetPart.Anchored = false; targetPart.CanCollide = true

                    local myPos = MyBasePosition or (LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.Position) or (EnemyTargetPosition + Vector3.new(0,0,50))
                    local dirToMyBase = (myPos - EnemyTargetPosition).Unit
                    local fixedFrontPos = EnemyTargetPosition + (dirToMyBase * 5)
                    
                    targetPart.CFrame = CFrame.lookAt(fixedFrontPos, EnemyTargetPosition)
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Velocity = (EnemyTargetPosition - fixedFrontPos).Unit * 400
                    bv.Parent = targetPart
                    
                    projectile.AncestryChanged:Connect(function() if not projectile:IsDescendantOf(game) then bv:Destroy() end end)
                    return
                end
            end

            -- 3. Mặc định Xanh Lá (Không bật HitBase, không Target Đỏ): Chỉ MỞ KHÓA đạn, rơi/bay bình thường
            targetPart.Anchored = false
            targetPart.CanCollide = true
            return
        end

        if state == 4 then
            if not EnemyTargetPosition then scanBases() end
            if EnemyTargetPosition then
                for _, child in ipairs(targetPart:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") or child:IsA("BodyForce") then child:Destroy() end
                end
                targetPart.Anchored = false; targetPart.CanCollide = true
                
                local tunnel = createStraightTunnel(targetPart.Position, EnemyTargetPosition, targetPart.Size)
                local baseWalls = createCenterBaseWall(EnemyTargetPosition, EnemyBaseSize)
                task.wait(0.02)
                
                if targetPart and targetPart.Parent then
                    local direction = (EnemyTargetPosition - targetPart.Position).Unit
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Velocity = direction * 500
                    bv.Parent = targetPart
                    
                    task.spawn(function()
                        while targetPart and targetPart.Parent do
                            local dist = (targetPart.Position - EnemyTargetPosition).Magnitude
                            if dist <= 6 then
                                bv.Velocity = Vector3.zero
                                targetPart.AssemblyLinearVelocity = Vector3.zero
                                targetPart.CFrame = CFrame.new(EnemyTargetPosition)
                                targetPart.Anchored = true
                                break
                            end
                            task.wait()
                        end
                    end)
                    
                    projectile.AncestryChanged:Connect(function()
                        if not projectile:IsDescendantOf(game) then 
                            bv:Destroy(); tunnel:Destroy(); baseWalls:Destroy()
                        end
                    end)
                end
            end
            return 
        end

        if state == 3 then
            targetPart.Anchored = false; targetPart.CanCollide = true
            local compactSize = targetPart.Size + Vector3.new(1.5, 1.5, 1.5)
            local cage = createHollowCage(targetPart.CFrame, compactSize)
            projectile.AncestryChanged:Connect(function() if not projectile:IsDescendantOf(game) then cage:Destroy() end end)
        elseif state == 1 then
            if string.find(pName:lower(), "grenade") then
                local kickerBox = Instance.new("Part")
                kickerBox.Size = targetPart.Size + Vector3.new(1, 1, 1)
                kickerBox.CFrame = targetPart.CFrame * CFrame.new(0, -0.5, 0)
                kickerBox.Transparency = 0.85; kickerBox.CanCollide = true; kickerBox.Parent = Workspace
                targetPart.Anchored = false; targetPart.CanCollide = true
                targetPart.AssemblyLinearVelocity = Vector3.new(0, 300, 0)
                kickerBox.AssemblyLinearVelocity = Vector3.new(0, 300, 0)
                projectile.AncestryChanged:Connect(function() if not projectile:IsDescendantOf(game) then kickerBox:Destroy() end end)
            else
                local lockBox = Instance.new("Part")
                lockBox.Size = targetPart.Size + Vector3.new(2, 2, 2)
                lockBox.CFrame = targetPart.CFrame
                lockBox.Transparency = 0.85; lockBox.Color = Color3.fromRGB(220, 50, 50)
                lockBox.Material = Enum.Material.SmoothPlastic; lockBox.Anchored = true; lockBox.CanCollide = true; lockBox.Parent = Workspace
                targetPart.Anchored = true; targetPart.CanCollide = true
                projectile.AncestryChanged:Connect(function() if not projectile:IsDescendantOf(game) then lockBox:Destroy() end end)
            end
        end
    end

    ProjectilsAddedConnection = ProjectileFolder.ChildAdded:Connect(processProjectile)
    for _, existing in ipairs(ProjectileFolder:GetChildren()) do processProjectile(existing) end
end

